<Window x:Class="Clpr.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Codex 项目修复 · CLPR 1.0" Width="1120" Height="800" MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#203147">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#EAF0F8"/><Setter Property="Foreground" Value="#264D7B"/><Setter Property="Padding" Value="18,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2865D6"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#B8C8DB"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="16,15"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#E6EBF2"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11,9"/><Setter Property="BorderBrush" Value="#D9E1ED"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGrid"><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="42"/><Setter Property="Background" Value="White"/><Setter Property="HorizontalGridLinesBrush" Value="#EEF1F6"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#16283E"><Grid Margin="16,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="CLPR" FontSize="30" Foreground="White" FontWeight="Bold" Margin="14,0,0,4"/><TextBlock Text="Codex 项目修复" Foreground="#A7BDD4" Margin="14,0,0,32"/>
    <Button x:Name="HomeNav" Style="{StaticResource Navigation}" Tag="home" Click="NavigateClick" Content="⌂   状态与备份"/>
    <Button x:Name="RestoreNav" Style="{StaticResource Navigation}" Tag="restore" Click="NavigateClick" Content="↺   恢复项目"/>
    <Button x:Name="HistoryNav" Style="{StaticResource Navigation}" Tag="history" Click="NavigateClick" Content="≡   操作记录"/>
   </StackPanel>
   <StackPanel Grid.Row="2" Margin="14,0,8,0"><TextBlock Text="数据留在本机" Foreground="#B8C8DB"/><TextBlock Text="无需联网 · 非官方工具" Foreground="#8DA5BE" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="版本 1.0" Foreground="#8DA5BE" FontSize="11" Margin="0,6,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,20"><TextBlock x:Name="PageTitle" Text="状态与备份" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="项目正常时保存一份快照，下次切号后就有据可恢复。" Foreground="#6B7D92" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Codex 数据目录" FontWeight="SemiBold" Margin="0,0,0,10"/><DockPanel><Button Content="重新扫描" DockPanel.Dock="Right" Click="ScanClick" Margin="10,0,0,0"/><Button Content="选择目录" DockPanel.Dock="Right" Click="HomeClick" Margin="10,0,0,0"/><TextBox x:Name="HomeBox" TextChanged="InputsChanged"/></DockPanel><TextBlock x:Name="EnvironmentText" Foreground="#6B7D92" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
     <UniformGrid Columns="3" Margin="0,0,0,16">
      <Border Style="{StaticResource Card}" Background="#EAF5F2" Margin="0,0,12,0"><StackPanel><TextBlock Text="当前项目 / 聊天归属" Foreground="#517A70"/><TextBlock x:Name="CountsText" Text="— / —" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="可恢复快照" Foreground="#6B7D92"/><TextBlock x:Name="CandidatesText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Codex 状态" Foreground="#6B7D92"/><TextBlock x:Name="ProcessText" Text="正在检查" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="GuidanceTitle" Text="正在读取本地状态…" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="GuidanceText" Foreground="#6B7D92" TextWrapping="Wrap" LineHeight="23" Margin="0,9,0,0"/></StackPanel></Border>
     <UniformGrid Columns="2">
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="切号前 · 保存正常状态" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="项目都在时点这里。快照会自动出现在恢复列表，无需记住路径。" Foreground="#6B7D92" TextWrapping="Wrap" LineHeight="23" Margin="0,10,0,18"/><Button Content="保存当前快照" Style="{StaticResource Primary}" Click="SnapshotClick" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="切号后 · 找回项目分组" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="项目消失时，选择已保存的快照，预览通过后直接恢复。" Foreground="#6B7D92" TextWrapping="Wrap" LineHeight="23" Margin="0,10,0,18"/><Button Content="开始恢复 →" Tag="restore" Click="NavigateClick" HorizontalAlignment="Left"/></StackPanel></Border>
     </UniformGrid>
    </StackPanel></ScrollViewer>
    <Grid x:Name="RestorePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="1   选择正常快照" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="优先选择你在切号前保存的快照，数量和时间供你核对。" Foreground="#6B7D92" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="刷新" Click="ScanClick" Padding="14,8" Margin="10,0,8,0"/><Button Content="导入快照…" Click="SourceClick" Padding="14,8"/></StackPanel></DockPanel>
      <DataGrid Grid.Row="1" x:Name="SnapshotsGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="SelectionChanged" MinHeight="90"><DataGrid.Columns><DataGridTextColumn Header="快照来源" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="项目" Binding="{Binding Projects}" Width="55"/><DataGridTextColumn Header="归属" Binding="{Binding Assignments}" Width="55"/><DataGridTextColumn Header="保存时间" Binding="{Binding Time}" Width="145"/><DataGridTextColumn Header="校验" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid>
      <TextBlock Grid.Row="2" x:Name="SelectionText" Text="尚未选择快照" Foreground="#6B7D92" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
     </Grid></Border>
     <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20"><StackPanel><DockPanel><TextBlock Text="2   预览恢复结果" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ExportButton" Content="导出详情" Click="ExportClick" Padding="14,8" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="PreviewButton" Content="生成恢复预览" Click="PreviewClick" Padding="14,8"/></StackPanel></DockPanel>
      <TextBlock x:Name="PreviewCounts" Text="选择快照后点击预览，程序会检查差异和项目关联。" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,15,0,0"/>
      <TextBlock x:Name="PreviewDetails" Text="预览不会改变当前状态。只有预览通过，恢复按钮才会亮起。" Foreground="#6B7D92" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>
      <Expander Header="查看文件路径与校验详情" Margin="0,12,0,0" Foreground="#6B7D92"><TextBox x:Name="TechnicalDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="115" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F6F8FC" FontSize="11"/></Expander>
     </StackPanel></Border>
     <Border Grid.Row="2" Background="#EAF0FC" CornerRadius="10" Padding="18" Margin="0,14,0,0"><DockPanel><Button x:Name="ApplyButton" Content="恢复项目" Style="{StaticResource Primary}" DockPanel.Dock="Right" Click="ApplyClick" IsEnabled="False" Padding="27,13" Margin="18,0,0,0"/><StackPanel><TextBlock Text="3   恢复项目" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="RecoveryHint" Text="请先完成预览。恢复前会自动备份，可在操作记录中回滚。" Foreground="#5D7291" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
    </Grid>
    <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><TextBlock Text="恢复操作记录" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="刷新记录" Click="RefreshHistoryClick" Padding="14,8" Margin="8,0,8,0"/><Button Content="导入操作记录…" Click="ImportOperationClick" Padding="14,8"/></StackPanel></DockPanel>
      <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="HistorySelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="操作时间" Binding="{Binding Time}" Width="*"/><DataGridTextColumn Header="项目 / 归属" Binding="{Binding Counts}" Width="130"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="160"/></DataGrid.Columns></DataGrid>
      <TextBlock x:Name="HistoryDetails" Grid.Row="2" Text="尚无操作记录。保存快照后不需要恢复；真正恢复过才会生成记录。" Foreground="#6B7D92" TextWrapping="Wrap" Margin="0,16,0,0"/>
     </Grid></Border>
     <Border Grid.Row="1" Background="#EAF0FC" CornerRadius="10" Padding="18" Margin="0,14,0,0"><DockPanel><Button x:Name="RollbackButton" Content="回滚选中操作" DockPanel.Dock="Right" Click="RollbackClick" IsEnabled="False" Margin="18,0,0,0"/><TextBlock Text="需要撤销恢复时选择一条记录。只有当前状态未被后续修改，才能回滚。" Foreground="#5D7291" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
    </Grid>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#DDE4EE" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0"><StackPanel><TextBlock x:Name="StatusText" Text="就绪 · 扫描与预览不会修改状态" Foreground="#48647F" TextWrapping="Wrap"/><TextBlock Text="仅恢复本地项目列表与聊天归属，不更改账号登录或云端授权。" Foreground="#8593A4" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
